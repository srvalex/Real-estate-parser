# Base URL of the internal analytics service (api/analytics_app.py).
ANALYTICS_API_BASE_URL=http://localhost:8100

# Must match ANALYTICS_API_TOKEN on the analytics service. Deliberately NOT
# prefixed with NEXT_PUBLIC_: it is read only in the Next server process
# (lib/server/analyticsClient.ts) and never reaches the browser.
ANALYTICS_API_TOKEN=change-me
